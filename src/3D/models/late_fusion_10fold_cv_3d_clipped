TARGET_COLUMN = 'Label'
PATIENT_ID_COLUMN = 'Patient ID'

# Optimized 3D ResNet18 Hyperparameters
BATCH_SIZE = 16
LEARNING_RATE = 1e-4
WEIGHT_DECAY = 1e-3
DROPOUT_RATE = 0.6
EPOCHS = 100
MIN_EPOCHS = 80
PATIENCE = 10

# Optimized XGBoost Hyperparameters 
XGB_LR = 0.05
XGB_DEPTH = 3
XGB_ESTIMATORS = 200
XGB_COLSAMPLE = 0.8
XGB_SUBSAMPLE = 1.0

# --- META-LEARNER WEIGHT CLIPPING CONFIG ---
CLIP_META_WEIGHTS = True
META_WEIGHT_MIN = 0.0  # Forces non-negative voting
META_WEIGHT_MAX = 1.0  # Strictly bounds weights between 0 and 1
