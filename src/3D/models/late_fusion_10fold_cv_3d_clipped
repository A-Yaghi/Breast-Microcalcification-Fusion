# ================= CONFIGURATION =================
CSV_PATH = "MCs_radiomics_features_Zero_background_Dilation_10_after_correlation.xlsx"
SPLIT_CSV_PATH = "master_10fold_splits.csv"  
IMAGE_DIR = "MCs_64x64x64"  
