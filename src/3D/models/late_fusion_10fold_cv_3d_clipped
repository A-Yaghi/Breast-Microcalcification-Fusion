def preload_all_volumes(df, root_dir):
    print("--- PRELOADING ALL 3D VOLUMES INTO RAM ---")
    volume_cache = {}
    unique_images = df['Image Path'].unique()
    
    for i, img_name in enumerate(unique_images):
        img_path = os.path.join(root_dir, img_name)
        volume, _ = nrrd.read(img_path)
        vol_tensor = torch.tensor(volume, dtype=torch.float32).unsqueeze(0)
        volume_cache[img_name] = vol_tensor
        
        if (i + 1) % 500 == 0:
            print(f"  Loaded {i + 1} / {len(unique_images)} volumes...")
            
    print(f"--- SUCCESSFULLY PRELOADED {len(volume_cache)} VOLUMES ---")
    return volume_cache

def calculate_metrics(y_true, y_probs, threshold=0.5):
    y_pred_bin = (np.array(y_probs) >= threshold).astype(int)
    
    try:
        auc_val = roc_auc_score(y_true, y_probs)
        acc_val = accuracy_score(y_true, y_pred_bin)
        f1_val = f1_score(y_true, y_pred_bin)
        
        tn, fp, fn, tp = confusion_matrix(y_true, y_pred_bin).ravel()
        sens_val = tp / (tp + fn) if (tp + fn) > 0 else 0.0
        spec_val = tn / (tn + fp) if (tn + fp) > 0 else 0.0
        
    except ValueError:
        auc_val, acc_val, f1_val, sens_val, spec_val = 0.5, 0.0, 0.0, 0.0, 0.0
        
    return auc_val, acc_val, f1_val, sens_val, spec_val

class MCs3DDataset(Dataset):
    def __init__(self, dataframe, volume_cache):
        self.dataframe = dataframe.reset_index(drop=True)
        self.volume_cache = volume_cache

    def __len__(self):
        return len(self.dataframe)

    def __getitem__(self, idx):
        img_name = self.dataframe.iloc[idx]['Image Path']
        label = int(self.dataframe.iloc[idx][TARGET_COLUMN])
        vol_tensor = self.volume_cache[img_name]
        return vol_tensor, label

class ResNet3DWrapper(nn.Module):
    def __init__(self, dropout_rate):
        super(ResNet3DWrapper, self).__init__()
        self.base_model = r3d_18(weights=None)
        
        original_conv1 = self.base_model.stem[0]
        self.base_model.stem[0] = nn.Conv3d(
            in_channels=1, 
            out_channels=original_conv1.out_channels, 
            kernel_size=original_conv1.kernel_size, 
            stride=original_conv1.stride, 
            padding=original_conv1.padding, 
            bias=False
        )
        
        num_ftrs = self.base_model.fc.in_features
        self.base_model.fc = nn.Sequential(
            nn.Dropout(dropout_rate),
            nn.Linear(num_ftrs, 1)
        )
        
    def forward(self, x):
        x = self.base_model(x)
        return x.to(torch.float32)

# --- PYTORCH CONVEX META-LEARNER ---
class ConvexMetaLearner(nn.Module):
    def __init__(self):
        super(ConvexMetaLearner, self).__init__()
        # Initialize raw weights to 0.0. 
        # softmax([0.0, 0.0]) = [0.5, 0.5], giving both models equal starting weight.
        self.raw_weights = nn.Parameter(torch.tensor([0.0, 0.0]))
        self.bias = nn.Parameter(torch.tensor([0.0]))

    def get_bounded_weights(self):
        # Softmax forces weights to be > 0 and sum exactly to 1.0
        return torch.softmax(self.raw_weights, dim=0)

    def forward(self, x):
        w = self.get_bounded_weights()
        return torch.matmul(x, w) + self.bias
