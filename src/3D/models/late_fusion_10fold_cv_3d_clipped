def plot_late_fusion_roc_curves(df):
    y_true = df['True_Label']

    # ==========================================
    # 1. POOLED ROC CURVE (All 3 Models)
    # ==========================================
    plt.figure(figsize=(10, 8), dpi=300)
    
    fpr_xgb, tpr_xgb, _ = roc_curve(y_true, df['XGB_Prob'])
    plt.plot(fpr_xgb, tpr_xgb, label=f"Radiomic XGBoost (AUC = {auc(fpr_xgb, tpr_xgb):.4f})", color='#2ca02c', lw=2)
    
    fpr_cnn, tpr_cnn, _ = roc_curve(y_true, df['CNN_Prob'])
    plt.plot(fpr_cnn, tpr_cnn, label=f"ResNet3D Image (AUC = {auc(fpr_cnn, tpr_cnn):.4f})", color='#1f77b4', lw=2)
    
    fpr_fusion, tpr_fusion, _ = roc_curve(y_true, df['Fusion_Prob'])
    plt.plot(fpr_fusion, tpr_fusion, label=f"Late Fusion Meta-Learner (AUC = {auc(fpr_fusion, tpr_fusion):.4f})", color='#d62728', lw=3)

    plt.plot([0, 1], [0, 1], 'k--', lw=2, label='Random Chance')
    plt.xlim([-0.01, 1.01])
    plt.ylim([-0.01, 1.05])
    plt.xlabel('False Positive Rate', fontsize=14)
    plt.ylabel('True Positive Rate', fontsize=14)
    plt.title('Phase 2: 3D Multimodal Late Fusion (Pooled)', fontsize=16, fontweight='bold')
    plt.legend(loc="lower right", fontsize=12)
    plt.grid(alpha=0.3)
    
    plt.savefig('late_fusion_pooled_roc_curve_3D.png', bbox_inches='tight')
    plt.close()
    print("\n -> Saved Pooled ROC curve to 'late_fusion_pooled_roc_curve_3D.png'")

    # ==========================================
    # 2. MEAN ROC CURVE (All 3 Models)
    # ==========================================
    plt.figure(figsize=(10, 8), dpi=300)
    mean_fpr = np.linspace(0, 1, 100)
    
    models = [
        ('XGB_Prob', 'Radiomic XGBoost', '#2ca02c', 2),
        ('CNN_Prob', 'ResNet3D Image', '#1f77b4', 2),
        ('Fusion_Prob', 'Late Fusion Meta-Learner', '#d62728', 3)
    ]
    
    for col, name, color, lw in models:
        tprs = []
        aucs = []
        for fold in sorted(df['Fold'].unique()):
            fold_df = df[df['Fold'] == fold]
            fpr, tpr, _ = roc_curve(fold_df['True_Label'], fold_df[col])
            aucs.append(auc(fpr, tpr))
            
            interp_tpr = np.interp(mean_fpr, fpr, tpr)
            interp_tpr[0] = 0.0
            tprs.append(interp_tpr)
        
        mean_tpr = np.mean(tprs, axis=0)
        mean_tpr[-1] = 1.0
        mean_auc = np.mean(aucs)
        std_auc = np.std(aucs)
        
        plt.plot(mean_fpr, mean_tpr, color=color, lw=lw,
                 label=r'%s (AUC = %0.4f $\pm$ %0.4f)' % (name, mean_auc, std_auc))
        
        # Add light standard deviation shading
        std_tpr = np.std(tprs, axis=0)
        tprs_upper = np.minimum(mean_tpr + std_tpr, 1)
        tprs_lower = np.maximum(mean_tpr - std_tpr, 0)
        plt.fill_between(mean_fpr, tprs_lower, tprs_upper, color=color, alpha=0.1)

    plt.plot([0, 1], [0, 1], 'k--', lw=2, label='Random Chance')
    plt.xlim([-0.01, 1.01])
    plt.ylim([-0.01, 1.05])
    plt.xlabel('False Positive Rate', fontsize=14)
    plt.ylabel('True Positive Rate', fontsize=14)
    plt.title('Phase 2: Mean ROC Curves (Late Fusion vs Baselines)', fontsize=16, fontweight='bold')
    plt.legend(loc="lower right", fontsize=12)
    plt.grid(alpha=0.3)

    plt.savefig('late_fusion_mean_roc_curve_3D.png', bbox_inches='tight')
    plt.close()
    print(" -> Saved Mean ROC curves to 'late_fusion_mean_roc_curve_3D.png'\n")

def main():
    wandb.init(
        project="embed-thesis-phase2-late-fusion-clipped",
        name=f"Phase2_3D_LateFusion_Constrained_{META_WEIGHT_MIN}to{META_WEIGHT_MAX}",
        config={
            "architecture": "ResNet3D + XGBoost Late Fusion",
            "epochs": EPOCHS,
            "batch_size": BATCH_SIZE,
            "clip_weights": CLIP_META_WEIGHTS,
            "weight_min": META_WEIGHT_MIN,
            "weight_max": META_WEIGHT_MAX
        }
    )

    print("--- LOADING DATA AND FIXED SPLITS ---")
    df = pd.read_excel(CSV_PATH).dropna(subset=[TARGET_COLUMN]).reset_index(drop=True)
    splits_df = pd.read_csv(SPLIT_CSV_PATH)
    df = df.merge(splits_df, on=PATIENT_ID_COLUMN, how='inner')
    
    print("--- EXTRACTING TOP 199 FEATURES FOR ABLATION ---")
    feature_counts = pd.read_csv(FEATURE_COUNTS_CSV)
    cutoff_feature = "wavelet3-LHL_glszm_ZoneEntropy"
    cutoff_idx = feature_counts[feature_counts['Selected_Feature'] == cutoff_feature].index[0]
    
    TOP_FEATURES = feature_counts['Selected_Feature'].iloc[:cutoff_idx+1].tolist()
    valid_top_features = [f for f in TOP_FEATURES if f in df.columns]
    print(f"Successfully matched {len(valid_top_features)} radiomic features to filter.")
    FEATURE_COLUMNS = valid_top_features
    
    global_volume_cache = preload_all_volumes(df, IMAGE_DIR)
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"--- USING DEVICE: {device} ---")

    # --- NEW: Added fold tracking list ---
    oof_fold, oof_true, oof_xgb, oof_cnn, oof_fusion = [], [], [], [], []
    
    metrics_log = {
        'xgb': {'auc': [], 'acc': [], 'f1': [], 'sens': [], 'spec': []},
        'cnn': {'auc': [], 'acc': [], 'f1': [], 'sens': [], 'spec': []},
        'fusion': {'auc': [], 'acc': [], 'f1': [], 'sens': [], 'spec': []}
    }

    for current_fold in range(1, 11):
        print("\n" + "="*50)
        print(f"========== STARTING FOLD {current_fold}/10 ==========")
        print("="*50)
        
        fold_df = df[df['Fold'] == current_fold]
        train_df = fold_df[fold_df['Split'] == 'Train'].copy()
        val_df = fold_df[fold_df['Split'] == 'Val'].copy()
        test_df = fold_df[fold_df['Split'] == 'Test'].copy()
        
        y_test_true = test_df[TARGET_COLUMN].values
        
        # --- NEW: Track folds for the test predictions ---
        oof_fold.extend([current_fold] * len(y_test_true))
        oof_true.extend(y_test_true)

        # --- 1. TABULAR XGBOOST (Radiomics) ---
        print("\n-> Training Tabular XGBoost...")
        X_train, y_train = train_df[FEATURE_COLUMNS], train_df[TARGET_COLUMN]
        X_test = test_df[FEATURE_COLUMNS]
        
        imputer = SimpleImputer(strategy='mean')
        scaler = StandardScaler()
        X_train_processed = scaler.fit_transform(imputer.fit_transform(X_train))
        X_test_processed = scaler.transform(imputer.transform(X_test))
        
        num_neg, num_pos = len(train_df[train_df[TARGET_COLUMN] == 0]), len(train_df[train_df[TARGET_COLUMN] == 1])
        scale_pos_weight = num_neg / num_pos if num_pos > 0 else 1.0
        
        xgb_model = XGBClassifier(
            learning_rate=XGB_LR, max_depth=XGB_DEPTH, n_estimators=XGB_ESTIMATORS,
            colsample_bytree=XGB_COLSAMPLE, subsample=XGB_SUBSAMPLE,
            scale_pos_weight=scale_pos_weight, eval_metric='auc', random_state=42
        )
        xgb_model.fit(X_train_processed, y_train)
        
        xgb_test_probs = xgb_model.predict_proba(X_test_processed)[:, 1]
        oof_xgb.extend(xgb_test_probs)
        
        xgb_auc, xgb_acc, xgb_f1, xgb_sens, xgb_spec = calculate_metrics(y_test_true, xgb_test_probs)
        for key, val in zip(['auc', 'acc', 'f1', 'sens', 'spec'], [xgb_auc, xgb_acc, xgb_f1, xgb_sens, xgb_spec]):
            metrics_log['xgb'][key].append(val)
        print(f"   Radiomic XGBoost Test AUC: {xgb_auc:.4f} | Acc: {xgb_acc:.4f} | F1: {xgb_f1:.4f}")

        # --- 2. IMAGE CNN (ResNet3D) ---
        print("\n-> Training Image ResNet3D...")
        train_loader = DataLoader(MCs3DDataset(train_df, global_volume_cache), batch_size=BATCH_SIZE, shuffle=True, num_workers=2)
        val_loader = DataLoader(MCs3DDataset(val_df, global_volume_cache), batch_size=BATCH_SIZE, shuffle=False, num_workers=2)
        test_loader = DataLoader(MCs3DDataset(test_df, global_volume_cache), batch_size=BATCH_SIZE, shuffle=False, num_workers=2)

        model = ResNet3DWrapper(dropout_rate=DROPOUT_RATE).to(device)
        criterion = nn.BCEWithLogitsLoss(pos_weight=torch.tensor([scale_pos_weight]).to(device))
        optimizer = optim.Adam(model.parameters(), lr=LEARNING_RATE, weight_decay=WEIGHT_DECAY)
        scaler_amp = torch.amp.GradScaler('cuda')

        best_fold_val_loss, best_model_weights, patience_counter = float('inf'), None, 0

        for epoch in range(EPOCHS):
            model.train()
            for inputs, labels in train_loader:
                inputs, labels = inputs.to(device), labels.float().unsqueeze(1).to(device)
                optimizer.zero_grad()
                with torch.autocast(device_type='cuda', dtype=torch.float16):
                    loss = criterion(model(inputs), labels)
                scaler_amp.scale(loss).backward()
                scaler_amp.step(optimizer)
                scaler_amp.update()
                
            model.eval() 
            running_val_loss = 0.0
            with torch.no_grad():
                for inputs, labels in val_loader:
                    inputs, labels = inputs.to(device), labels.float().unsqueeze(1).to(device)
                    with torch.autocast(device_type='cuda', dtype=torch.float16):
                        loss = criterion(model(inputs), labels)
                    running_val_loss += loss.item()
                    
            avg_val_loss = running_val_loss / len(val_loader)
                
            if avg_val_loss < best_fold_val_loss:
                best_fold_val_loss = avg_val_loss
                best_model_weights = copy.deepcopy(model.state_dict())
                patience_counter = 0
            elif epoch + 1 >= MIN_EPOCHS:
                patience_counter += 1

            if epoch + 1 >= MIN_EPOCHS and patience_counter >= PATIENCE:
                print(f"   [!] CNN Early stopping at Epoch {epoch+1}")
                break 

        model.load_state_dict(best_model_weights)
        model.eval()
        cnn_test_probs = []
        with torch.no_grad():
            for inputs, _ in test_loader:
                with torch.autocast(device_type='cuda', dtype=torch.float16):
                    outputs = model(inputs.to(device))
                cnn_test_probs.extend(torch.sigmoid(outputs).cpu().numpy().flatten())

        oof_cnn.extend(cnn_test_probs)
        
        cnn_auc, cnn_acc, cnn_f1, cnn_sens, cnn_spec = calculate_metrics(y_test_true, cnn_test_probs)
        for key, val in zip(['auc', 'acc', 'f1', 'sens', 'spec'], [cnn_auc, cnn_acc, cnn_f1, cnn_sens, cnn_spec]):
            metrics_log['cnn'][key].append(val)
        print(f"   Image ResNet3D Test AUC: {cnn_auc:.4f} | Acc: {cnn_acc:.4f} | F1: {cnn_f1:.4f}")

        # --- 3. STACKING FUSION (BOUNDED PYTORCH META-LEARNER) ---
        print("\n-> Training Meta-Learner (Fusion) with Bounded Weights...")
        xgb_train_probs = xgb_model.predict_proba(X_train_processed)[:, 1]
        
        cnn_train_probs = []
        with torch.no_grad():
            for inputs, _ in DataLoader(MCs3DDataset(train_df, global_volume_cache), batch_size=BATCH_SIZE, shuffle=False, num_workers=2):
                with torch.autocast(device_type='cuda', dtype=torch.float16):
                    outputs = model(inputs.to(device))
                cnn_train_probs.extend(torch.sigmoid(outputs).cpu().numpy().flatten())

        # Prepare fusion features
        X_meta_train = np.column_stack((xgb_train_probs, cnn_train_probs))
        X_meta_test = np.column_stack((xgb_test_probs, cnn_test_probs))
        
        # Convert to PyTorch Tensors
        X_meta_train_t = torch.tensor(X_meta_train, dtype=torch.float32).to(device)
        y_meta_train_t = torch.tensor(train_df[TARGET_COLUMN].values, dtype=torch.float32).to(device)
        X_meta_test_t = torch.tensor(X_meta_test, dtype=torch.float32).to(device)

        # Initialize Convex Meta-Learner (Sum-to-One constraint)
        meta_model = ConvexMetaLearner().to(device)
        
        # We reuse the same scale_pos_weight derived from the training fold
        meta_criterion = nn.BCEWithLogitsLoss(pos_weight=torch.tensor([scale_pos_weight]).to(device))
        meta_optimizer = optim.Adam(meta_model.parameters(), lr=0.05)

        # Train Meta-Learner explicitly to optimize bias WITH the bounded weights
        meta_model.train()
        for _ in range(150):  # 150 epochs is plenty for a 2-parameter logistic regression
            meta_optimizer.zero_grad()
            logits = meta_model(X_meta_train_t)
            loss = meta_criterion(logits.squeeze(), y_meta_train_t)
            loss.backward()
            meta_optimizer.step()
        
        # Evaluate Meta-Learner
        meta_model.eval()
        with torch.no_grad():
            fusion_logits = meta_model(X_meta_test_t)
            fusion_probs = torch.sigmoid(fusion_logits).cpu().numpy().flatten()
            final_weights = meta_model.get_bounded_weights().cpu().numpy()

        oof_fusion.extend(fusion_probs)
        
        fusion_auc, fusion_acc, fusion_f1, fusion_sens, fusion_spec = calculate_metrics(y_test_true, fusion_probs)
        for key, val in zip(['auc', 'acc', 'f1', 'sens', 'spec'], [fusion_auc, fusion_acc, fusion_f1, fusion_sens, fusion_spec]):
            metrics_log['fusion'][key].append(val)
        
        print(f"   Learned Bounded Weights -> XGBoost: {final_weights[0]:.4f} | CNN: {final_weights[1]:.4f}")
        print(f"   Fold {current_fold} FUSION TEST AUC: {fusion_auc:.4f} | Acc: {fusion_acc:.4f} | F1: {fusion_f1:.4f}")

        wandb.log({
            f"fold_{current_fold}_xgb_test_auc": xgb_auc,
            f"fold_{current_fold}_cnn_test_auc": cnn_auc,
            f"fold_{current_fold}_fusion_test_auc": fusion_auc
        })

    # --- FINAL REPORT ---
    print("\n" + "="*50)
    print("10-FOLD CV 3D LATE FUSION ABLATION COMPLETE")
    print("="*50)
    
    for model_name, display_name in zip(['xgb', 'cnn', 'fusion'], ['Radiomic XGBoost', 'ResNet3D Image', 'LATE FUSION']):
        mean_auc, std_auc = np.mean(metrics_log[model_name]['auc']), np.std(metrics_log[model_name]['auc'])
        print(f"\n[{display_name}]")
        print(f" Mean AUC:  {mean_auc:.4f} ± {std_auc:.4f}")
        print(f" Mean Acc:  {np.mean(metrics_log[model_name]['acc']):.4f}")
        print(f" Mean F1:   {np.mean(metrics_log[model_name]['f1']):.4f}")
        
    # --- FINAL EXPORT & PLOTTING ---
    predictions_df = pd.DataFrame({
        'Fold': oof_fold,          # <--- Fold is now correctly tracked and saved
        'True_Label': oof_true, 
        'XGB_Prob': oof_xgb, 
        'CNN_Prob': oof_cnn, 
        'Fusion_Prob': oof_fusion
    })
    
    predictions_df.to_csv('late_fusion_clipped_predictions.csv', index=False)
    print("\n -> Saved raw predictions to 'late_fusion_clipped_predictions.csv'")
    
    # Generate the Pooled and Mean ROC curves automatically
    plot_late_fusion_roc_curves(predictions_df)
    
    wandb.finish()

if __name__ == '__main__':
    main()
