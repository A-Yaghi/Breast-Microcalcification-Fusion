import os
import pandas as pd
import numpy as np
import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms
from sklearn.model_selection import GroupKFold
from sklearn.metrics import roc_auc_score
from PIL import Image
import itertools
import wandb

# ================= CONFIGURATION =================
CSV_PATH = "Tabular/training_manifest.csv"
IMAGE_DIR = "Images"  
IMAGE_SIZE = 512
N_SPLITS = 5  
TARGET_COLUMN = 'target_label'
PATIENT_ID_COLUMN = 'empi_anon'

EPOCHS = 100               # Increased to 100
MIN_EPOCHS = 50            # Minimum epochs before early stopping kicks in
PATIENCE = 8               # How many epochs to wait for an improvement
# =================================================

# --- 1. IMAGE ONLY DATASET ---
class MammographyImageDataset(Dataset):
    def __init__(self, dataframe, root_dir, transform=None):
        self.dataframe = dataframe.reset_index(drop=True)
        self.root_dir = root_dir
        self.transform = transform

    def __len__(self):
        return len(self.dataframe)

    def __getitem__(self, idx):
        img_rel_path = self.dataframe.iloc[idx]['cropped_image_file']
        img_rel_path = img_rel_path.replace('Actionable', 'Malignant').replace('Nonactionable', 'Benign')
        img_path = os.path.join(self.root_dir, img_rel_path)
        
        image = Image.open(img_path).convert('L')
        if self.transform:
            image = self.transform(image)

        label = int(self.dataframe.iloc[idx][TARGET_COLUMN])
        return image, label

# --- 2. SIMPLE 3-LAYER CNN ---
class SimpleCNN(nn.Module):
    def __init__(self, dropout_rate=0.5):
        super(SimpleCNN, self).__init__()
        self.conv1 = nn.Conv2d(3, 16, kernel_size=3, padding=1)
        self.pool = nn.MaxPool2d(2, 2)
        
        self.conv2 = nn.Conv2d(16, 32, kernel_size=3, padding=1)
        self.conv3 = nn.Conv2d(32, 64, kernel_size=3, padding=1)
        
        self.global_pool = nn.AdaptiveAvgPool2d((4, 4))
        
        self.fc1 = nn.Linear(64 * 4 * 4, 128)
        self.dropout = nn.Dropout(dropout_rate)
        self.fc2 = nn.Linear(128, 1)

    def forward(self, x):
        x = self.pool(torch.relu(self.conv1(x)))
        x = self.pool(torch.relu(self.conv2(x)))
        x = self.pool(torch.relu(self.conv3(x)))
        x = self.global_pool(x)
        x = torch.flatten(x, 1)
        x = torch.relu(self.fc1(x))
        x = self.dropout(x)
        x = self.fc2(x)
        return x

# --- 3. MAIN GRID SEARCH PIPELINE ---
def main():
    print("--- LOADING DATA ---")
    df = pd.read_csv(CSV_PATH).dropna(subset=[TARGET_COLUMN]).reset_index(drop=True)
    gkf = GroupKFold(n_splits=N_SPLITS)
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

    param_grid = {
        'lr': [0.001, 0.0001],
        'batch_size': [16, 32],
        'dropout': [0.3, 0.6]
    }
    
    keys, values = zip(*param_grid.items())
    combinations = [dict(zip(keys, v)) for v in itertools.product(*values)]
    
    print(f"--- STARTING GRID SEARCH ({len(combinations)} Configurations) ---")

    train_transform = transforms.Compose([
        transforms.Resize((IMAGE_SIZE, IMAGE_SIZE)), 
        transforms.RandomHorizontalFlip(), 
        transforms.RandomVerticalFlip(),   
        transforms.RandomRotation(degrees=15),  
        transforms.Grayscale(num_output_channels=3), 
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])
    ])

    val_transform = transforms.Compose([
        transforms.Resize((IMAGE_SIZE, IMAGE_SIZE)), 
        transforms.Grayscale(num_output_channels=3), 
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])
    ])

    best_overall_auc = 0.0
    best_params = None

    for config_idx, config in enumerate(combinations):
        print(f"\n[{config_idx+1}/{len(combinations)}] Testing Params: {config}")
        
        # Initialize wandb for this specific configuration
        run_name = f"SimpleCNN_lr{config['lr']}_bs{config['batch_size']}_drop{config['dropout']}"
        wandb.init(
            project="embed-mammography-thesis",
            name=run_name,
            config=config,
            reinit=True
        )
        wandb.define_metric("epoch")
        wandb.define_metric("*", step_metric="epoch")
        
        fold_aucs = []
        
        for fold, (train_idx, val_idx) in enumerate(gkf.split(df, groups=df[PATIENT_ID_COLUMN])):
            train_df, val_df = df.iloc[train_idx].copy(), df.iloc[val_idx].copy()
            
            train_dataset = MammographyImageDataset(train_df, IMAGE_DIR, train_transform)
            val_dataset = MammographyImageDataset(val_df, IMAGE_DIR, val_transform)

            train_loader = DataLoader(train_dataset, batch_size=config['batch_size'], shuffle=True, num_workers=4)
            val_loader = DataLoader(val_dataset, batch_size=config['batch_size'], shuffle=False, num_workers=4)

            model = SimpleCNN(dropout_rate=config['dropout']).to(device)
            
            num_neg = len(train_df[train_df[TARGET_COLUMN] == 0])
            num_pos = len(train_df[train_df[TARGET_COLUMN] == 1])
            pos_weight = torch.tensor([num_neg / num_pos]).to(device)

            criterion = nn.BCEWithLogitsLoss(pos_weight=pos_weight)
            optimizer = optim.Adam(model.parameters(), lr=config['lr'])
            
            best_fold_auc = 0.0
            patience_counter = 0
            
            for epoch in range(EPOCHS):
                model.train()
                running_train_loss = 0.0
                for images, labels in train_loader:
                    images, labels = images.to(device), labels.float().unsqueeze(1).to(device)
                    optimizer.zero_grad()
                    loss = criterion(model(images), labels)
                    loss.backward()
                    optimizer.step()
                    running_train_loss += loss.item()
                
                avg_train_loss = running_train_loss / len(train_loader)
                
                model.eval()
                running_val_loss = 0.0
                val_true, val_pred = [], []
                with torch.no_grad():
                    for images, labels in val_loader:
                        images, labels = images.to(device), labels.float().unsqueeze(1).to(device)
                        outputs = model(images)
                        loss = criterion(outputs, labels)
                        running_val_loss += loss.item()
                        val_true.extend(labels.cpu().numpy())
                        val_pred.extend(torch.sigmoid(outputs).cpu().numpy())
                
                avg_val_loss = running_val_loss / len(val_loader)
                
                try:
                    val_auc = roc_auc_score(val_true, val_pred)
                except ValueError:
                    val_auc = 0.5
                
                # W&B Logging per epoch
                wandb.log({
                    f"fold_{fold+1}_train_loss": avg_train_loss,
                    f"fold_{fold+1}_val_loss": avg_val_loss,
                    f"fold_{fold+1}_val_auc": val_auc,
                    "epoch": epoch
                })

                # --- NEW EARLY STOPPING LOGIC ---
                if val_auc > best_fold_auc:
                    best_fold_auc = val_auc
                    patience_counter = 0 # Always reset if it improves
                elif epoch >= MIN_EPOCHS:
                    patience_counter += 1 # Only start adding patience AFTER epoch 50
                
                if epoch >= MIN_EPOCHS and patience_counter >= PATIENCE:
                    print(f"[!] Fold {fold+1} Early stopping at Epoch {epoch+1} (Best AUC: {best_fold_auc:.4f})")
                    break
                    
            fold_aucs.append(best_fold_auc)
            wandb.log({f"final_fold_{fold+1}_auc": best_fold_auc})
            
        mean_cv_auc = np.mean(fold_aucs)
        std_cv_auc = np.std(fold_aucs)
        print(f" -> Mean AUC for config: {mean_cv_auc:.4f} ± {std_cv_auc:.4f}")
        
        wandb.log({"mean_cv_auc": mean_cv_auc, "std_cv_auc": std_cv_auc})
        wandb.finish() # End the W&B run for this configuration
        
        if mean_cv_auc > best_overall_auc:
            best_overall_auc = mean_cv_auc
            best_params = config

    print("\n" + "="*50)
    print("SIMPLE CNN HYPERPARAMETER OPTIMIZATION COMPLETE")
    print("="*50)
    print(f"BEST MEAN CV AUC: {best_overall_auc:.4f}")
    print(f"OPTIMAL PARAMETERS: {best_params}")
    print("="*50 + "\n")

if __name__ == '__main__':
    main()
