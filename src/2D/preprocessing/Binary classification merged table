import pandas as pd
import numpy as np
import ast
from sklearn.preprocessing import StandardScaler

# 1. Load the dataset
file_path = r""
print("Loading dataset...")
df = pd.read_csv(file_path)

# ==========================================
# STEP A: Parse the Bounding Boxes
# ==========================================
# Converts the string "[[x1, y1, x2, y2]]" into a real Python list
print("Parsing ROI coordinates...")
def parse_coords(coord_str):
    try:
        # ast.literal_eval safely evaluates strings containing Python values
        return ast.literal_eval(coord_str)
    except:
        return []

df['ROI_coords'] = df['ROI_coords'].apply(parse_coords)

# ==========================================
# STEP B & D: Handle Missing Data & Placeholders
# ==========================================
print("Imputing missing values...")

# In EMBED, missing sizes or distances are sometimes recorded as -99 or -1. 
# We must replace these with NaN first, otherwise the AI will think the tumor is -99mm wide!
df['size'] = df['size'].replace([-99, -1, -99.0, -1.0], np.nan)
df['distance'] = df['distance'].replace([-99, -1, -99.0, -1.0], np.nan)

# Define our feature groups
num_cols = ['age_at_study', 'size', 'distance', 'tissueden']
cat_cols = ['location', 'depth', 'ETHNIC_GROUP_DESC', 'ETHNICITY_DESC']
multi_cat_cols = ['calcfind', 'calcdistri'] # These can have comma-separated values

# Impute Numerical with Median (Robust to outliers)
for col in num_cols:
    median_val = df[col].median()
    df[col] = df[col].fillna(median_val)

# Impute Categorical with "Unknown"
for col in cat_cols + multi_cat_cols:
    df[col] = df[col].fillna('Unknown')
    # Convert to string and clean up extra spaces
    df[col] = df[col].astype(str).str.strip()

# ==========================================
# STEP C: Numerical Normalization (Scaling)
# ==========================================
# We use StandardScaler (Z-score) to center data around 0 with a variance of 1.
print("Applying Standard Scaling to continuous features...")
scaler = StandardScaler()
df[num_cols] = scaler.fit_transform(df[num_cols])

# ==========================================
# STEP D: Categorical Encoding (One-Hot)
# ==========================================
print("Encoding categorical features...")

# 1. Standard One-Hot Encoding for single-value categories (Race, Depth, etc.)
encoded_df = pd.get_dummies(df, columns=cat_cols, drop_first=False)

# 2. Multi-Hot Encoding for BI-RADS features
# Because calcfind can be "A,M" (Amorphous AND Pleomorphic), we need to split by comma.
for col in multi_cat_cols:
    # Get dummies that splits by comma automatically
    dummies = df[col].str.get_dummies(sep=',')
    # Add a prefix so we know where the column came from (e.g., calcfind_A, calcfind_M)
    dummies = dummies.add_prefix(f"{col}_")
    # Join it to our main dataframe and drop the original text column
    encoded_df = pd.concat([encoded_df, dummies], axis=1)
    encoded_df = encoded_df.drop(columns=[col])

# ==========================================
# FINAL CLEANUP & SAVE
# ==========================================
# Ensure boolean True/False columns from get_dummies are converted to 1.0 and 0.0 for PyTorch/TensorFlow
bool_cols = encoded_df.select_dtypes(include=['bool']).columns
encoded_df[bool_cols] = encoded_df[bool_cols].astype(float)

# Save the final Tensor-ready dataset
output_filename = r"C:\Users\q_51_\VUB Pixiu Drive\be57b692-7569-4b64-863a-57a6fb0ab95e\etro-embed-mammo\processing\Abbas.Yaghi\Tabular\fusion_ready_tensors.csv"
encoded_df.to_csv(output_filename, index=False)

print(f"\nSuccess! Dataset fully preprocessed and saved to '{output_filename}'")
print(f"Total columns expanded to: {len(encoded_df.columns)}")





import os
import ast
import cv2
import pydicom
import numpy as np
import pandas as pd

# ================= CONFIGURATION =================
# 1. Path to your preprocessed CSV file
csv_path = r""

# 2. Root folder where the source 'images' are located
SOURCE_ROOT = r""

# 3. Output folders for the two classes
ACTIONABLE_ROOT = r""
NONACTIONABLE_ROOT = r""

# 4. The final training manifest output
MANIFEST_OUTPUT = r""

# Create directories if they don't exist
os.makedirs(ACTIONABLE_ROOT, exist_ok=True)
os.makedirs(NONACTIONABLE_ROOT, exist_ok=True)

# Fixed crop size for the Neural Network
CROP_SIZE = 512
HALF_CROP = CROP_SIZE // 2
# =================================================

def normalize_and_save(crop, output_path):
    """
    1. Min-Max Normalization to 16-bit range.
    2. Save as 1-channel 16-bit PNG.
    (CLAHE removed to prevent high-frequency noise amplification)
    """
    crop = crop.astype(float)
    min_val = np.min(crop)
    max_val = np.max(crop)
    
    if max_val - min_val > 0:
        crop_norm = (crop - min_val) / (max_val - min_val) * 65535
    else:
        crop_norm = crop
        
    crop_uint16 = crop_norm.astype(np.uint16)

    # Save directly without CLAHE
    cv2.imwrite(output_path, crop_uint16)

def save_roi_crops():
    df = pd.read_csv(csv_path)
    print(f"Found {len(df)} records. Starting processing...")
    
    success_count = 0
    error_count = 0
    generated_filenames = []

    for index, row in df.iterrows():
        dicom_rel_path = row['anon_dicom_path']
        dicom_full_path = os.path.join(SOURCE_ROOT, dicom_rel_path)
        
        final_saved_filename = np.nan 

        try:
            rois = ast.literal_eval(row['ROI_coords'])
            
            if os.path.exists(dicom_full_path) and len(rois) > 0:
                ds = pydicom.dcmread(dicom_full_path)
                pixel_array = ds.pixel_array

                # Invert MONOCHROME1
                if hasattr(ds, 'PhotometricInterpretation') and ds.PhotometricInterpretation == "MONOCHROME1":
                    max_possible = (2 ** ds.BitsStored) - 1
                    pixel_array = max_possible - pixel_array
                
                # --- FIXED-WINDOW 512x512 CROPPING ---
                ymin, xmin, ymax, xmax = rois[0] 
                
                # 1. Find the center of the bounding box
                center_y = int((ymin + ymax) / 2)
                center_x = int((xmin + xmax) / 2)
                
                # 2. Calculate new 512x512 boundaries
                new_ymin = center_y - HALF_CROP
                new_ymax = center_y + HALF_CROP
                new_xmin = center_x - HALF_CROP
                new_xmax = center_x + HALF_CROP
                
                # 3. Shift window if it goes out of image bounds
                if new_ymin < 0:
                    new_ymax -= new_ymin; new_ymin = 0
                if new_xmin < 0:
                    new_xmax -= new_xmin; new_xmin = 0
                if new_ymax > pixel_array.shape[0]:
                    new_ymin -= (new_ymax - pixel_array.shape[0]); new_ymax = pixel_array.shape[0]
                if new_xmax > pixel_array.shape[1]:
                    new_xmin -= (new_xmax - pixel_array.shape[1]); new_xmax = pixel_array.shape[1]
                
                # Ensure no negative indices in edge cases
                new_ymin = max(0, new_ymin)
                new_xmin = max(0, new_xmin)
                
                roi_crop = pixel_array[new_ymin:new_ymax, new_xmin:new_xmax]
                
                # 4. Pad with black pixels if the image itself is smaller than 512x512
                if roi_crop.shape[0] != CROP_SIZE or roi_crop.shape[1] != CROP_SIZE:
                    pad_y = max(0, CROP_SIZE - roi_crop.shape[0])
                    pad_x = max(0, CROP_SIZE - roi_crop.shape[1])
                    roi_crop = np.pad(roi_crop, ((0, pad_y), (0, pad_x)), mode='constant', constant_values=0)
                
                # --- ROUTING & SAVING ---
                if roi_crop.shape == (CROP_SIZE, CROP_SIZE):
                    patient_id = row.get('empi_anon', f'patient_{index}')
                    acc_id = row.get('acc_anon', 'no_acc')
                    
                    filename = f"{patient_id}_{acc_id}_roi_{index}.png"
                    
                    # Determine which folder to put it in based on target_label
                    if row['target_label'] == 1.0:
                        folder_path = ACTIONABLE_ROOT
                        rel_folder_name = "Actionable"
                    else:
                        folder_path = NONACTIONABLE_ROOT
                        rel_folder_name = "Nonactionable"
                        
                    output_path = os.path.join(folder_path, filename)
                    
                    # Normalize and save (NO CLAHE)
                    normalize_and_save(roi_crop, output_path)
                    
                    # Save the relative path (e.g. "Actionable/patient_123_roi_0.png") for the Dataloader
                    final_saved_filename = f"{rel_folder_name}/{filename}"
                    success_count += 1
                    
                    if success_count % 50 == 0:
                        print(f"Processed {success_count} images...")
                        
        except Exception as e:
            print(f"Error processing row {index}: {e}")
            error_count += 1
            
        generated_filenames.append(final_saved_filename)

    # --- CRITICAL DATALOADER LINKAGE ---
    df['cropped_image_file'] = generated_filenames
    df_clean = df.dropna(subset=['cropped_image_file'])
    df_clean.to_csv(MANIFEST_OUTPUT, index=False)

    print(f"\nDone! Successfully processed: {success_count}. Errors: {error_count}.")
    print(f"Training Manifest saved to: {MANIFEST_OUTPUT}")

if __name__ == "__main__":
    save_roi_crops()
