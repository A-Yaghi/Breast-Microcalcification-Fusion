import pandas as pd

# 1. Load Data
meta_path = r""
clin_path = r""

print("Loading datasets...")
meta_df = pd.read_csv(meta_path, low_memory=False)
clin_df = pd.read_csv(clin_path, low_memory=False)

# 2. Join the two tables (Keeps empi_anon and acc_anon intact)
# This inherently performs a many-to-many join
print("Merging data on patient and accession IDs...")
merged_df = pd.merge(meta_df, clin_df, on=['empi_anon', 'acc_anon'], how='inner')

# 3. Handle Laterality (Clinical 'side' <-> Metadata 'ImageLateralityFinal')
def match_laterality(row):
    clin_side = row['side']
    img_side = row['ImageLateralityFinal']
    
    # 1. Native Pandas check: If either is truly empty/null, keep it to be safe!
    if pd.isna(clin_side) or pd.isna(img_side):
        return True
        
    clin_side = str(clin_side).strip().upper()
    img_side = str(img_side).strip().upper()
    
    # 2. Comprehensive list of "Bilateral" or "Unknown" string flags
    safe_flags = [
        'B', 'BILATERAL', 'BOTH', 
        'NAN', '<NA>', 'NONE', 'NULL', '', 'NA', 'N/A', 
        'UN', 'UNKNOWN'
    ]
    
    # If EITHER the clinical note or the image is Bilateral/Unknown, 
    # it safely matches with anything.
    if clin_side in safe_flags or img_side in safe_flags:
        return True
        
    # 3. Strict Direct Matches
    if clin_side in ['L', 'LEFT'] and img_side in ['L', 'LEFT']: 
        return True
    if clin_side in ['R', 'RIGHT'] and img_side in ['R', 'RIGHT']: 
        return True
        
    # Mismatch (e.g., Clinical explicitly says L, but Image explicitly says R)
    return False

print("Filtering for laterality matches...")
# Optional Debugging: Let's see exactly how many are being dropped!
initial_count = len(merged_df)
merged_df = merged_df[merged_df.apply(match_laterality, axis=1)]
print(f"Laterality Filter: Kept {len(merged_df)} out of {initial_count} rows.")

# 4. Filter for Calcifications & Valid ROIs
print("\n Filtering for Calcifications & Valid ROIs")
current_count = len(merged_df)
print(f"1. Starting rows from laterality match: {current_count}")

# Filter 4A: Keep only rows where a calcification is described
calc_df = merged_df[merged_df['calcfind'].notna()]
calc_count = len(calc_df)
print(f"   -> Dropped {current_count - calc_count} rows (No calcification found).")
print(f"2. Remaining rows with calcifications:  {calc_count}")

# Filter 4B: Keep only rows where ROI coordinates actually exist (not NaN)
calc_df = calc_df[calc_df['ROI_coords'].notna()]
roi_nan_count = len(calc_df)
print(f"   -> Dropped {calc_count - roi_nan_count} rows (ROI_coords column is NaN).")
print(f"3. Remaining rows with non-null ROIs:   {roi_nan_count}")

# Filter 4C: Remove empty bracket string '[]' (which means no box was drawn)
calc_df = calc_df[calc_df['ROI_coords'] != '[]']
valid_roi_count = len(calc_df)
print(f"   -> Dropped {roi_nan_count - valid_roi_count} rows (ROI_coords is empty '[]').")
print(f"4. Final valid microcalcification ROIs: {valid_roi_count}")

# 5. Clean Target Label (Based on official EMBED path_severity)
# 0: invasive, 1: non-invasive, 2: high-risk, 3: borderline, 4: benign, 5: negative, 6: non-breast
print("\n=== STEP 5: GROUND TRUTH LABELS ===")
def map_severity(val):
    if pd.isna(val): return None
    try:
        val = int(float(val))
    except:
        return None
        
    if val in [0, 1, 2, 3]: return 1      # Actionable
    if val in [4, 5]: return 0            # Non-Actionable
    return None                           # Drops 6 (non-breast)

calc_df['target_label'] = calc_df['path_severity'].apply(map_severity)

# Filter out the missing labels and log the drop
final_df = calc_df[calc_df['target_label'].notna()]

labeled_count = len(final_df)
print(f"   -> Dropped {valid_roi_count - labeled_count} rows (No ground truth 'path_severity' available).")
print(f"5. Final Dataset with valid images AND labels: {labeled_count}")

# 6. Select Final Features
features_to_keep = [
    'empi_anon', 'acc_anon', 'side', 'ImageLateralityFinal',
    'anon_dicom_path', 'ROI_coords', 'num_ROI', 'ViewPosition',
    'age_at_study', 'size', 'distance', 'location', 'depth', 
    'calcfind', 'calcdistri', 'tissueden', 'ETHNIC_GROUP_DESC', 'ETHNICITY_DESC',
    'path_severity', 'target_label'
]
final_df = final_df[[col for col in features_to_keep if col in final_df.columns]]

# 7. Print Accurate Many-to-Many Statistics
print("\n=== FINAL DATASET STATISTICS ===")
print(f"Total Patient Visits (Unique Accessions): {final_df['acc_anon'].nunique()}")
print(f"Total Unique Images (Dicom Paths):        {final_df['anon_dicom_path'].nunique()}")
print(f"Total Rows (Image-to-Finding Pairs):      {len(final_df)}")
print(f"Actionable ROI pairs:                      {len(final_df[final_df['target_label'] == 1])}")
print(f"Non-Actionable ROI pairs:                 {len(final_df[final_df['target_label'] == 0])}")

# 8. Save
output_filename = r""
final_df.to_csv(output_filename, index=False)
print(f"\nSaved to {output_filename}")



